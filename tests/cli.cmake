if(NOT DEFINED HUFFBLOCK OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "HUFFBLOCK and TEST_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
# Keep each test run isolated; never delete a pre-existing user directory.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run_dir "${TEST_DIR}/${run_id}")
file(MAKE_DIRECTORY "${run_dir}")

function(run_expected expected)
    execute_process(COMMAND "${HUFFBLOCK}" ${ARGN}
        WORKING_DIRECTORY "${run_dir}"
        TIMEOUT 15
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${ARGN}\n${stdout}\n${stderr}")
    endif()
endfunction()

run_expected(0 --help)
run_expected(0 --version)
run_expected(2)
run_expected(2 unknown)
run_expected(2 compress)
run_expected(2 compress a b c)
foreach(size IN ITEMS 0 -1 16777217 4294967296 1x +1)
    run_expected(2 compress --block-size "${size}" input output)
endforeach()
run_expected(2 compress --block-size)
run_expected(2 compress --block-size 1 --block-size 2 a b)
run_expected(2 decompress --block-size 1 a b)
foreach(count IN ITEMS 0 -1 257 4294967296 1x +1)
    run_expected(2 compress --threads "${count}" a b)
    run_expected(2 decompress --threads "${count}" a b)
endforeach()
foreach(count IN ITEMS 0 -1 1025 4294967296 1x +1)
    run_expected(2 compress --max-in-flight "${count}" a b)
endforeach()
run_expected(2 compress --threads)
run_expected(2 decompress --max-in-flight)
run_expected(2 compress --threads 1 --threads 2 a b)
run_expected(2 decompress --max-in-flight 1 --max-in-flight 2 a b)
run_expected(2 compress --unknown a b)
run_expected(2 compress --max-output 1 a b)
run_expected(2 decompress --max-output)
run_expected(2 decompress --max-output 1 --max-output 2 a b)
run_expected(2 compress --buffer-limit 1 --buffer-limit 2 a b)
foreach(value IN ITEMS -1 1x +1 18446744073709551616)
    run_expected(2 decompress --max-output "${value}" a b)
    run_expected(2 compress --buffer-limit "${value}" a b)
endforeach()
run_expected(2 compress --buffer-limit 0 a b)
run_expected(1 compress missing.bin missing.hfb)
if(EXISTS "${run_dir}/missing.hfb")
    message(FATAL_ERROR "Missing input created an output file")
endif()

string(REPEAT "ABRACADABRA!" 1000 content)
file(WRITE "${run_dir}/input with spaces.txt" "${content}")
run_expected(0 compress --block-size 4096 "input with spaces.txt" archive.hfb)
run_expected(0 decompress archive.hfb restored.txt)
file(SHA256 "${run_dir}/input with spaces.txt" original_hash)
file(SHA256 "${run_dir}/restored.txt" restored_hash)
if(NOT original_hash STREQUAL restored_hash)
    message(FATAL_ERROR "CLI round trip changed the input")
endif()
file(SHA256 "${run_dir}/archive.hfb" archive_hash)
string(LENGTH "${content}" content_size)
run_expected(0 decompress --max-output "${content_size}" archive.hfb limited.txt)
run_expected(1 decompress --max-output 1 archive.hfb over-limit.txt)
run_expected(1 compress --buffer-limit 1 "input with spaces.txt" over-budget.hfb)
if(EXISTS "${run_dir}/over-limit.txt" OR EXISTS "${run_dir}/over-budget.hfb")
    message(FATAL_ERROR "Resource failure published output")
endif()
foreach(threads IN ITEMS 1 2 4)
    run_expected(0 compress --threads "${threads}" --max-in-flight 1 --block-size 4096
        "input with spaces.txt" "parallel-${threads}.hfb")
    run_expected(0 decompress --threads "${threads}" --max-in-flight 2
        "parallel-${threads}.hfb" "parallel-${threads}.txt")
    file(SHA256 "${run_dir}/parallel-${threads}.hfb" parallel_hash)
    file(SHA256 "${run_dir}/parallel-${threads}.txt" parallel_restored_hash)
    if(NOT parallel_hash STREQUAL archive_hash OR NOT parallel_restored_hash STREQUAL original_hash)
        message(FATAL_ERROR "Thread count changed CLI output")
    endif()
endforeach()
run_expected(1 compress "input with spaces.txt" archive.hfb)
run_expected(1 decompress archive.hfb restored.txt)
run_expected(1 compress "input with spaces.txt" "input with spaces.txt")
file(SHA256 "${run_dir}/archive.hfb" preserved_hash)
file(SHA256 "${run_dir}/input with spaces.txt" preserved_input_hash)
file(SHA256 "${run_dir}/restored.txt" preserved_output_hash)
if(NOT archive_hash STREQUAL preserved_hash OR
   NOT original_hash STREQUAL preserved_input_hash OR
   NOT restored_hash STREQUAL preserved_output_hash)
    message(FATAL_ERROR "A rejected overwrite modified a file")
endif()

file(WRITE "${run_dir}/invalid.hfb" "not an archive")
run_expected(1 decompress invalid.hfb partial.txt)
if(EXISTS "${run_dir}/partial.txt")
    message(FATAL_ERROR "Failed decompression left partial output")
endif()
file(GLOB temporary_files "${run_dir}/.huffblock-*")
if(temporary_files)
    message(FATAL_ERROR "Temporary output was not cleaned: ${temporary_files}")
endif()
file(WRITE "${run_dir}/empty.bin" "")
run_expected(0 compress empty.bin empty.hfb)
run_expected(0 decompress empty.hfb empty-restored.bin)
run_expected(0 decompress --max-output 0 empty.hfb empty-limited.bin)
file(SIZE "${run_dir}/empty.hfb" empty_archive_size)
file(SIZE "${run_dir}/empty-restored.bin" empty_size)
if(NOT empty_size EQUAL 0 OR NOT empty_archive_size EQUAL 40)
    message(FATAL_ERROR "Invalid empty-file round trip")
endif()
file(WRITE "${run_dir}/unicode-ሀ-日本.txt" "Unicode paths work")
run_expected(0 compress "unicode-ሀ-日本.txt" "unicode-ሀ-日本.hfb")
run_expected(0 decompress "unicode-ሀ-日本.hfb" "restored-ሀ-日本.txt")
file(READ "${run_dir}/restored-ሀ-日本.txt" unicode_content)
if(NOT unicode_content STREQUAL "Unicode paths work")
    message(FATAL_ERROR "Unicode path round trip failed")
endif()
file(WRITE "${run_dir}/-input" "dash-prefixed name")
run_expected(0 compress -- -input -output)
run_expected(0 decompress -- -output -restored)
file(READ "${run_dir}/-restored" dash_content)
if(NOT dash_content STREQUAL "dash-prefixed name")
    message(FATAL_ERROR "Dash-prefixed path round trip failed")
endif()
message(STATUS "CLI checks passed; artifacts: ${run_dir}")
